<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>3.0.0</version>
        <id>datatables.net-editor-bs5</id>
        <description>This is Editor for DataTables with styling for [Bootstrap5](https://getbootstrap.com/)</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>https://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>Editing  CRUD  Inline  Modal  Multi-row  Bootstrap  Bootstrap5  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-editor" version="3.0.0"/>
            <dependency id="datatables.net-bs5" version="[3.0.0, 4.0.0)"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/editor.bootstrap5.js" target="content\Scripts"/>
        <file src="js/editor.bootstrap5.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/editor.bootstrap5.min.js" target="content\Scripts"/>
        <file src="js/editor.bootstrap5.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/editor.bootstrap5.min.mjs" target="content\Scripts"/>
        <file src="js/editor.bootstrap5.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/editor.bootstrap5.mjs" target="content\Scripts"/>
        <file src="js/editor.bootstrap5.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/editor.bootstrap5.css" target="content\Content"/>
        <file src="css/editor.bootstrap5.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/editor.bootstrap5.min.css" target="content\Content"/>
        <file src="css/editor.bootstrap5.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
